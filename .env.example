# Required — Discord bot token from the Developer Portal
DISCORD_TOKEN=

# Required — Discord application/client ID
DISCORD_CLIENT_ID=

# Optional — guild-specific command registration (faster for dev)
DISCORD_GUILD_ID=

# Required for AI features — Google Gemini API key
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional — how many hours of messages to analyze (default: 24, max: 168)
COMMUNITY_ANALYSIS_HOURS=24
