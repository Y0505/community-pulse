{
  "name": "community-pulse",
  "version": "1.0.0",
  "description": "AI-ready Discord community intelligence and automation bot",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --import tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "deploy:commands": "node --import tsx src/deploy-commands.ts",
    "check": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "discord",
    "bot",
    "community",
    "typescript"
  ],
  "author": "Yaser Montazeri",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
